# Copy this file to .env and fill in real values. Never commit .env.
# See DATABASE.md, SECURITY.md and INTEGRATIONS.md for details on each group.

# --- Database (Supabase-hosted PostgreSQL) ---------------------------------
# DATABASE_URL: Transaction pooler connection (port 6543, ?pgbouncer=true).
#   Used by Prisma Client at runtime (src/lib/db.ts).
DATABASE_URL=
# DIRECT_URL: Direct connection or Session pooler (port 5432).
#   Used by the Prisma CLI for migrations (prisma.config.ts) — PgBouncer's
#   transaction mode cannot run schema migrations.
DIRECT_URL=
# TEST_DATABASE_URL: a SEPARATE database used only by integration tests and
#   `npm run db:test:migrate`. Never point this at your dev or prod database.
#   The provided docker-compose.yml exposes a local Postgres on port 56032,
#   e.g. postgresql://chaioboutique_test:chaioboutique_test@localhost:56032/chaioboutique_test
TEST_DATABASE_URL=
# DEV_DATABASE_URL: local Postgres used by `npm run dev` (and `dev:local`,
#   a kept alias) — see DATABASE.md's "Local development database" section.
#   REQUIRED for `npm run dev`: that command is fail-closed and refuses to
#   start without it, rather than ever silently falling back to Supabase.
#   Never point this at your test or prod database. The provided
#   docker-compose.yml exposes a local Postgres on port 56033 for this
#   (`npm run db:dev:up`), e.g.
#   postgresql://chaioboutique_dev:chaioboutique_dev@localhost:56033/chaioboutique_dev
#   Need the real Supabase database instead (rare, deliberate)? Use
#   `npm run dev:remote -- --yes` — never plain `npm run dev`.
DEV_DATABASE_URL=

# --- Better Auth -------------------------------------------------------------
# Generate with: openssl rand -base64 32
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:3000

# --- Supabase Storage ---------------------------------------------------------
# SUPABASE_SECRET_KEY uses Supabase's current secret-key format (sb_secret_...),
# not the legacy service_role JWT, and not the publishable key — see SECURITY.md.
SUPABASE_URL=
SUPABASE_SECRET_KEY=
SUPABASE_PRODUCT_IMAGES_BUCKET=product-images

# --- Public app URL ------------------------------------------------------------
# Client-safe: read directly via process.env.NEXT_PUBLIC_APP_URL in Client
# Components, not through src/lib/env.ts.
NEXT_PUBLIC_APP_URL=http://localhost:3000

# --- Store -------------------------------------------------------------------
STORE_NAME=CHAIOBOUTIQUE
STORE_CURRENCY=ARS
STORE_LOCALE=es-AR
STORE_TIMEZONE=America/Argentina/Cordoba

# Store social/contact presence and physical branches are configured live
# from /admin/settings (StoreConfiguration.publicPhone/whatsappPhone/
# publicEmail/instagramUrl/facebookUrl/tiktokUrl, and the StoreBranch
# table) — no env vars for these; nothing to set here.

# --- E2E testing only ---------------------------------------------------------
# Never set this by hand. playwright.config.ts sets it to "true" only for the
# dedicated e2e webServer instance (port 3100), which switches product-image
# uploads to an in-memory, locally-served provider instead of real Supabase
# Storage — see modules/storage/e2e-provider.ts.
E2E_TEST_MODE=false

# --- Initial administrator (production-safe seed) ---------------------------
# Both must be set for the seed to create an admin account. If either is
# missing, the seed skips admin creation with a clear log message.
INITIAL_ADMIN_NAME=
INITIAL_ADMIN_EMAIL=
INITIAL_ADMIN_PASSWORD=

# --- Email --------------------------------------------------------------------
# Dev default: Mailpit (see docker-compose.yml), SMTP on localhost:1025,
# web UI at http://localhost:8025.
EMAIL_PROVIDER=smtp
SMTP_HOST=localhost
SMTP_PORT=1025
# Mailpit needs neither TLS nor auth — leave these blank locally. A real relay
# would set SMTP_SECURE=true plus SMTP_USER/SMTP_PASSWORD.
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
EMAIL_FROM=no-reply@chaioboutique.local
# Left blank this phase — production email provider (Resend) is not wired up
# yet. See INTEGRATIONS.md.
RESEND_API_KEY=

# --- Local performance debugging (temporary, dev-only) -----------------------
# Set to "true" to log per-call server-side timings (session resolution,
# permission resolution, product queries, login/cart actions) to the `next
# dev` console — see src/lib/timing.ts. Never has any effect in production,
# regardless of this value.
DEBUG_TIMING=false

# --- Mercado Pago Checkout Pro -------------------------------------------------
# All optional — leave blank to keep this integration disabled (the "Pagar
# con Mercado Pago" button stays hidden; the webhook route 404s). Use TEST
# credentials from "Tus integraciones" in the Mercado Pago developer
# dashboard first — never real production credentials during development or
# automated/manual testing. Server-only: never prefixed NEXT_PUBLIC_, never
# commit real values.
MERCADO_PAGO_ACCESS_TOKEN=
MERCADO_PAGO_WEBHOOK_SECRET=
# Must be exactly "TEST" or "PRODUCTION" — required together with
# MERCADO_PAGO_ACCESS_TOKEN. Never guessed from the token's own shape (see
# modules/payments/mercado-pago/config-core.ts) — controls only which
# Checkout Pro URL (sandbox vs. production) preferences resolve to, and the
# startup diagnostic banner.
MERCADO_PAGO_ENVIRONMENT=
# Overrides NEXT_PUBLIC_APP_URL for Mercado Pago's back_urls/
# notification_url only — set this to an HTTPS tunnel URL (e.g. an ngrok
# URL) ONLY while manually testing a real Mercado Pago sandbox payment from
# localhost; Mercado Pago cannot call http://localhost directly. Leave
# blank otherwise — it falls back to NEXT_PUBLIC_APP_URL.
MERCADO_PAGO_PUBLIC_BASE_URL=

# --- Internal maintenance endpoint (scheduler-ready reservation sweep) -------
# Shared secret for POST /api/internal/expire-stale-orders — see that
# route's own comment. Leave blank to keep the endpoint fully disabled (it
# refuses every request with no way around it). Generate with e.g.
# `openssl rand -base64 32` before configuring a real scheduled job against
# it.
INTERNAL_TASK_SECRET=

# --- ARCA (WSAA/WSFEv1) homologation certificate ------------------------------
# All optional — leave blank to keep real ARCA connectivity disabled (the
# admin "Probar conexión con ARCA" action and "Emitir en ARCA — Homologación"
# stay blocked with a clear readiness message; every other feature, including
# MANUAL/SISTEMA_EXTERNO invoicing, keeps working unaffected). FILE PATHS to
# a local .pem certificate/private key — never paste certificate or key
# content directly into this file. Get a real pair from ARCA's own
# "Administrador de Certificados Digitales" for the HOMOLOGATION (testing)
# environment — never a production certificate for local development or
# automated/manual testing. Keep the actual .pem files OUTSIDE this repo or
# in a path already covered by .gitignore (*.pem/*.key/*.p12/*.pfx) —
# never commit them.
ARCA_CERTIFICATE_PATH=
ARCA_PRIVATE_KEY_PATH=
# Only needed if the private key file is itself passphrase-protected. Leave
# blank for an unencrypted key (the common case for a freshly generated
# homologation key pair).
ARCA_PRIVATE_KEY_PASSPHRASE=

# Production: 32 random bytes, hexadecimal. Keep stable; encrypts order links and queued emails.
# Back up separately from the database. Never expose as NEXT_PUBLIC_.
DATA_ENCRYPTION_KEY=
# Vercel cron: random bearer secret, at least 16 characters (recommended 32+).
CRON_SECRET=
