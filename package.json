{
  "name": "chaioboutique",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "node scripts/with-dev-db.mjs next dev --webpack",
    "dev:local": "npm run dev",
    "dev:remote": "node scripts/with-remote-db.mjs next dev --webpack",
    "build": "npm run prisma:generate && next build",
    "start": "next start",
    "lint": "eslint",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "tsc --noEmit",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate dev",
    "prisma:migrate:deploy": "prisma migrate deploy",
    "prisma:seed": "prisma db seed",
    "preflight:size-groups": "tsx scripts/preflight-size-groups-migration.ts",
    "db:dev:up": "docker compose up -d postgres-dev",
    "db:dev:migrate": "node scripts/with-dev-db.mjs prisma migrate deploy",
    "db:dev:seed": "node scripts/with-dev-db.mjs prisma db seed",
    "db:test:migrate": "node scripts/with-test-db.mjs prisma migrate deploy",
    "test": "vitest run tests/unit",
    "test:unit": "vitest run tests/unit",
    "test:integration": "node scripts/with-test-db.mjs vitest run --config vitest.integration.config.ts",
    "test:migrations": "node scripts/with-test-db.mjs vitest run --config vitest.migrations.config.ts",
    "test:e2e": "npm run db:test:migrate && node scripts/with-test-db.mjs playwright test",
    "test:e2e:headed": "npm run db:test:migrate && node scripts/with-test-db.mjs playwright test --headed",
    "preflight:production": "tsx scripts/preflight-production.ts"
  },
  "dependencies": {
    "@hookform/resolvers": "^5.4.0",
    "@prisma/adapter-pg": "^7.9.0",
    "@prisma/client": "^7.9.0",
    "@supabase/supabase-js": "^2.110.8",
    "asn1js": "^4.0.0",
    "better-auth": "^1.6.24",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "csv-parse": "^7.0.3",
    "date-fns": "^4.4.0",
    "date-fns-tz": "^3.2.0",
    "fast-xml-parser": "^5.11.2",
    "image-size": "^2.0.4",
    "lucide-react": "^1.25.0",
    "mercadopago": "^3.4.0",
    "next": "^16.4.2",
    "nodemailer": "^10.2.1",
    "pg": "^8.22.0",
    "pkijs": "^4.0.0",
    "radix-ui": "^1.6.5",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "react-hook-form": "^7.82.0",
    "server-only": "^0.0.1",
    "sonner": "^2.0.7",
    "tailwind-merge": "^3.6.0",
    "tw-animate-css": "^1.4.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@playwright/test": "^1.61.1",
    "@tailwindcss/postcss": "^4",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^7.0.0",
    "@testing-library/react": "^16.3.2",
    "@types/node": "^20",
    "@types/node-forge": "^1.3.14",
    "@types/nodemailer": "^8.0.1",
    "@types/pg": "^8.20.0",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitejs/plugin-react": "^6.0.4",
    "dotenv-cli": "^11.0.0",
    "eslint": "^9",
    "eslint-config-next": "^16.4.2",
    "eslint-config-prettier": "^10.1.8",
    "jsdom": "^29.1.1",
    "node-forge": "^1.4.0",
    "prettier": "^3.9.6",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "prisma": "^7.9.0",
    "tailwindcss": "^4",
    "tsx": "^4.23.1",
    "typescript": "^5",
    "vitest": "^4.1.12"
  },
  "overrides": {
    "fast-uri": "^3.1.8",
    "find-my-way": "^9.10.0",
    "lodash": "^4.18.1",
    "mysql2": "^3.24.6",
    "nanoid": "^3.3.18",
    "source-map-js": "^1.2.2",
    "valibot": "^1.5.0",
    "vite": "^8.3.5",
    "deepmerge-ts": "^8.0.2"
  }
}
